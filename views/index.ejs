<%- include('partials/landing-header') %>

<!-- SECTION 1 — Night Lot hero -->
<section class="landing-hero">
  <div class="landing-inner landing-hero-content">
    <h1 class="landing-headline">Wholesale without<br>the auction fees.</h1>
    <p class="landing-sub">Licensed dealers trading directly. One flat $599/month — first 30 days free.
       Unlimited buying and selling. <strong>No auction fees.</strong></p>
    <div class="cta-row landing-cta">
      <a class="btn btn-lg" href="/signup">Apply for Access</a>
      <a class="btn btn-lg btn-ghost landing-outline-btn" href="#how">See How It Works</a>
    </div>
    <p class="landing-fineprint">Wholesale license required. Applications are reviewed before activation.
       Card required at signup — nothing is charged until your 30-day trial ends.</p>
  </div>
  <div class="landing-sample-card" aria-hidden="true">
    <div class="landing-sample-top">
      <span class="landing-sample-title">2021 Silverado 1500</span>
      <span class="verified-badge sm">&#10003; Verified</span>
    </div>
    <div class="price landing-sample-price">$42,500</div>
    <div class="landing-sample-caption">Sample listing</div>
  </div>
  <a class="landing-scroll-hint" href="#story" aria-label="Scroll down to our story">
    <span>Scroll</span>
    <span class="landing-scroll-arrow">&#8595;</span>
  </a>
</section>

<!-- SECTION 2 — Auction vs. us -->
<section class="landing-split" id="story">
  <div class="landing-split-panel landing-split-old"></div>
  <div class="landing-split-panel landing-split-new"></div>
  <div class="landing-split-overlay">
    <div class="landing-split-card landing-reveal">
      <h2 class="landing-headline landing-headline-md">Get out of the old lanes.</h2>
      <p class="landing-sub">Dealers trading directly with dealers. No auction house in the middle.</p>
      <a class="btn btn-lg" href="/signup">Apply for Access</a>
    </div>
  </div>
</section>

<!-- SECTION 3 — How it works -->
<section class="landing-section" id="how">
  <div class="landing-inner">
    <h2 class="landing-h2 landing-reveal">How it works</h2>
    <ol class="landing-steps">
      <li class="landing-reveal">
        <span class="landing-step-num">1</span>
        <p><strong>Apply</strong> with your dealership details and wholesale license.</p>
      </li>
      <li class="landing-reveal">
        <span class="landing-step-num">2</span>
        <p><strong>Get approved</strong> — we verify every license before activation.</p>
      </li>
      <li class="landing-reveal">
        <span class="landing-step-num">3</span>
        <p><strong>Activate</strong> your membership — first 30 days free, then $599/month with secure card billing. Cancel anytime during the trial and pay nothing.</p>
      </li>
      <li class="landing-reveal">
        <span class="landing-step-num">4</span>
        <p><strong>Trade</strong> — list unlimited vehicles, browse the wholesale board, deal direct.</p>
      </li>
    </ol>
  </div>
</section>

<!-- SECTION 4 — Get the app -->
<section class="landing-section landing-app" id="app">
  <div class="landing-inner landing-app-grid">
    <div class="landing-app-copy landing-reveal">
      <img class="landing-app-icon" src="/icon-512.png" alt="TradeAutoX app icon" width="112" height="112">
      <h2 class="landing-h2">Take TradeAutoX anywhere</h2>
      <p>The wholesale board in your pocket. Browse listings, jump into live auctions, and upload
         listing photos right from your phone — whether you're on the lot, in the lane, or at your desk.
         Install the app and TradeAutoX is one tap away.</p>
      <button id="landing-install-btn" class="btn btn-lg" type="button">Install the App</button>
      <div id="landing-install-help" class="landing-install-help" hidden>
        <p><strong>iPhone:</strong> tap the Share button, then &ldquo;Add to Home Screen&rdquo;.</p>
        <p><strong>Android:</strong> tap the menu (&#8942;), then &ldquo;Install app&rdquo;.</p>
      </div>
    </div>
    <div class="landing-app-qr landing-reveal">
      <img src="/img/app-qr.png" alt="QR code to open TradeAutoX on your phone" width="220" height="220">
      <p class="muted">Scan with your phone to open TradeAutoX</p>
    </div>
  </div>
</section>

<!-- SECTION 5 — Pricing & why dealers join -->
<section class="landing-section" id="pricing">
  <div class="landing-inner">
    <h2 class="landing-h2 landing-reveal">One flat membership</h2>
    <div class="cards landing-cards">
      <div class="card landing-reveal">
        <h3>$599 / month, flat — first 30 days free</h3>
        <p>One membership covers everything. Buy and sell as many vehicles as you want — the auction fees are gone. Try it free for 30 days; your card isn't charged until the trial ends.</p>
        <p><a class="btn" href="/signup">Apply for Access</a></p>
      </div>
      <div class="card landing-reveal">
        <h3>Licensed dealers only</h3>
        <p>Every member holds a valid wholesale license, verified at signup. No public buyers, no tire-kickers.</p>
      </div>
      <div class="card landing-reveal">
        <h3>Front-line ready to salvage</h3>
        <p>List anything from front-line-ready units to salvage. Photos, VIN, mileage, and direct dealer contact on every listing.</p>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  // Reveal on scroll
  var revealEls = document.querySelectorAll('.landing-reveal');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    revealEls.forEach(function (el) { io.observe(el); });
  } else {
    revealEls.forEach(function (el) { el.classList.add('is-visible'); });
  }

  // "Install the App" button — PWA install prompt, with platform instructions as fallback.
  // (The footer partial also runs an install banner off the same event; both listeners coexist.)
  var installBtn = document.getElementById('landing-install-btn');
  var installHelp = document.getElementById('landing-install-help');
  if (!installBtn) return;
  if (window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone) {
    installBtn.textContent = 'App installed';
    installBtn.disabled = true;
    return;
  }
  var landingDeferredPrompt = null;
  window.addEventListener('beforeinstallprompt', function (e) {
    e.preventDefault();
    landingDeferredPrompt = e;
  });
  window.addEventListener('appinstalled', function () {
    landingDeferredPrompt = null;
    installBtn.textContent = 'App installed';
    installBtn.disabled = true;
    installHelp.hidden = true;
  });
  installBtn.addEventListener('click', async function () {
    if (landingDeferredPrompt) {
      try {
        landingDeferredPrompt.prompt();
        await landingDeferredPrompt.userChoice;
        landingDeferredPrompt = null;
        return;
      } catch (err) { /* fall through to instructions */ }
    }
    installHelp.hidden = false;
  });
})();
</script>

<%- include('partials/footer') %>
