<%- include('partials/header') %>

<h1>Reset your password</h1>

<% if (error) { %><p class="alert error"><%= error %></p><% } %>
<% if (notice) { %><p class="alert ok"><%= notice %></p><% } %>

<p class="muted">Enter the email on your dealer account. The administrator will send you a temporary password.</p>

<form class="form" method="post" action="/forgot-password">
  <label>Email
    <input type="email" name="email" required>
  </label>
  <button class="btn" type="submit">Request reset</button>
</form>
<p class="muted"><a href="/login">Back to login</a></p>

<%- include('partials/footer') %>
