<%- include('partials/header') %>

<h1>Membership activated</h1>
<% if (dealer.membership_status === 'active') { %>
  <p class="alert ok"><strong>You're in — and your first 30 days are free.</strong> Your TradeAutoX membership is active: unlimited buying and selling, no auction fees. Your card won't be charged until the trial ends.</p>
  <div class="cta-row">
    <a class="btn" href="/listings">Browse the board</a>
    <a class="btn btn-ghost" href="/listings/new">Post a vehicle</a>
  </div>
<% } else { %>
  <p class="alert warn">Your payment is being confirmed — this usually takes under a minute. If your dashboard still shows inactive, wait a moment and refresh.</p>
  <a class="btn" href="/dashboard">Go to dashboard</a>
<% } %>

<%- include('partials/footer') %>
