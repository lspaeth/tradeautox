<%- include('partials/header') %>

<h1>Dealer application</h1>
<p class="muted">Membership is <strong>$599/month</strong>, billed after approval. A valid wholesale license is required.</p>

<% if (error) { %><p class="alert error"><%= error %></p><% } %>

<form class="form" method="post" action="/signup" enctype="multipart/form-data">
  <label>Dealership name *
    <input name="dealership_name" required>
  </label>
  <label>Contact name *
    <input name="contact_name" required>
  </label>
  <label>Email *
    <input type="email" name="email" required>
  </label>
  <label>Password * <span class="muted small">(min 8 characters)</span>
    <span class="pw-wrap">
      <input type="password" name="password" minlength="8" required>
      <button type="button" class="pw-toggle" aria-label="Show password">👁</button>
    </span>
  </label>
  <label>Phone
    <input name="phone" type="tel">
  </label>
  <label>Dealership street address <span class="muted small">(so deal sheets can list it)</span>
    <input name="address" autocomplete="street-address">
  </label>
  <label>City
    <input name="city" autocomplete="address-level2">
  </label>
  <label>State
    <input name="state" maxlength="2" autocomplete="address-level1" placeholder="GA">
  </label>
  <label>Dealership ZIP code * <span class="muted small">(powers radius search and live auction alerts)</span>
    <input name="zip" inputmode="numeric" maxlength="5" autocomplete="postal-code" required>
  </label>
  <label>Wholesale license number *
    <input name="license_number" required>
  </label>
  <label>License photo <span class="muted small">(image upload — on your phone, tap to use the camera)</span>
    <input type="file" name="license_photo" accept="image/*" capture="environment">
  </label>
  <fieldset class="dl-verify">
    <legend>Verify your driver's license</legend>
    <p class="muted small">Scan the barcode on the <strong>back</strong> of your driver's license and your
      application arrives at approval pre-checked — name and expiration verified against the card.</p>
    <button type="button" class="btn btn-sm" id="dl-scan-btn">📷 Scan driver's license</button>
    <p id="dl-status" class="muted small" aria-live="polite">Not scanned yet.</p>
    <label class="check">
      <input type="checkbox" id="dl-skip" value="1">
      No camera right now — I'll verify at approval
    </label>
    <p class="muted small">Privacy: the photo of your license never leaves your phone — only the details printed on the card are read and sent.</p>
    <input type="hidden" name="dl_payload" id="dl-payload" value="">
  </fieldset>
  <label class="check">
    <input type="checkbox" name="accept_terms" value="1" required>
    I accept the <a href="/terms" target="_blank" rel="noopener">Terms of Service</a> and acknowledge the <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a> *
  </label>
  <button class="btn" type="submit">Submit application</button>
</form>

<%- include('partials/password-toggle') %>
<%- include('partials/dl-scanner') %>
<%- include('partials/footer') %>
