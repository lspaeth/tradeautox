<%- include('partials/header') %>

<h1>Dealer application</h1>
<p class="muted">Membership is <strong>$599/month</strong>, billed after approval. A valid wholesale license is required.</p>

<% if (error) { %><p class="alert error"><%= error %></p><% } %>

<form class="form" method="post" action="/signup" enctype="multipart/form-data">
  <label>Dealership name *
    <input name="dealership_name" required>
  </label>
  <label>Contact name *
    <input name="contact_name" required>
  </label>
  <label>Email *
    <input type="email" name="email" required>
  </label>
  <label>Password * <span class="muted small">(min 8 characters)</span>
    <span class="pw-wrap">
      <input type="password" name="password" minlength="8" required>
      <button type="button" class="pw-toggle" aria-label="Show password">👁</button>
    </span>
  </label>
  <label>Phone
    <input name="phone" type="tel">
  </label>
  <label>Dealership ZIP code * <span class="muted small">(powers radius search and live auction alerts)</span>
    <input name="zip" inputmode="numeric" maxlength="5" autocomplete="postal-code" required>
  </label>
  <label>Wholesale license number *
    <input name="license_number" required>
  </label>
  <label>License photo <span class="muted small">(image upload — on your phone, tap to use the camera)</span>
    <input type="file" name="license_photo" accept="image/*" capture="environment">
  </label>
  <label class="check">
    <input type="checkbox" name="accept_terms" value="1" required>
    I accept the <a href="/terms" target="_blank" rel="noopener">Terms of Service</a> *
  </label>
  <button class="btn" type="submit">Submit application</button>
</form>

<%- include('partials/password-toggle') %>
<%- include('partials/footer') %>
