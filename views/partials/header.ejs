<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>TradeAutoX</title>
<link rel="stylesheet" href="/styles.css">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#0a0b0d">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="TradeAutoX">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => { navigator.serviceWorker.register('/sw.js').catch(() => {}); });
}
</script>
</head>
<body>
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/"><img src="/logo.png" alt="TradeAutoX"></a>
    <nav>
      <% if (currentDealer) { %>
        <a href="/listings">Browse</a>
        <a href="/listings/new">Sell a vehicle</a>
        <a href="/dashboard">Dashboard</a>
        <a href="/logout">Log out</a>
      <% } else if (isAdmin) { %>
        <a href="/admin">Admin</a>
        <a href="/admin/logout">Log out</a>
      <% } else { %>
        <a href="/login">Dealer login</a>
        <a class="btn btn-sm" href="/signup">Join — 30 days free</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="wrap">
