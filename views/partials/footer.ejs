</main>
<footer class="site-footer">
  <div class="wrap">
    <p><strong>TRADE<span>AUTO</span>X</strong> — wholesale vehicles on demand. Licensed dealers only.</p>
    <p class="muted">Flat $599/month membership. Unlimited buying &amp; selling. No auction fees.</p>
    <p class="muted small"><a href="/terms">Terms of Service</a> · <a href="/privacy">Privacy Policy</a> — TradeAutoX is a listing venue only, not a party to any transaction.</p>
    <p class="muted small">Build <%= buildCommit %></p>
  </div>
</footer>
<div id="install-banner" class="install-banner" hidden>
  <span>Install the TradeAutoX app for quick photo uploads.</span>
  <button id="install-btn" class="btn btn-sm" type="button">Install</button>
  <button id="install-dismiss" class="install-dismiss" type="button" aria-label="Dismiss">&times;</button>
</div>
<script>
(function () {
  let deferredPrompt = null;
  const banner = document.getElementById('install-banner');
  // Already installed (standalone) or previously dismissed — stay quiet.
  if (window.matchMedia('(display-mode: standalone)').matches || localStorage.getItem('tax-install-dismissed')) return;
  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    banner.hidden = false;
  });
  document.getElementById('install-btn').addEventListener('click', async () => {
    if (!deferredPrompt) return;
    deferredPrompt.prompt();
    await deferredPrompt.userChoice;
    deferredPrompt = null;
    banner.hidden = true;
  });
  // iOS: no beforeinstallprompt — show a one-time "Add to Home Screen" hint.
  const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
  if (isIOS && !localStorage.getItem('tax-install-dismissed') && !navigator.standalone) {
    banner.querySelector('span').textContent = 'Install the TradeAutoX app: tap Share, then "Add to Home Screen".';
    document.getElementById('install-btn').style.display = 'none';
    banner.hidden = false;
  }
  document.getElementById('install-dismiss').addEventListener('click', () => {
    banner.hidden = true;
    localStorage.setItem('tax-install-dismissed', '1');
  });
})();
</script>
<% if (currentDealer || isAdmin) { %>
<script>
(function () {
  // Idle auto-logout: 5 minutes with no activity signs the session out.
  // The server enforces the same limit (lib/idle.js); this just makes it
  // visible while the user is staring at a page instead of waiting for
  // their next click. Admin-only sessions go back to the admin login.
  var IDLE_MS = <%= idleTimeoutMs %>;
  var LOGOUT_URL = '<%= (isAdmin && !currentDealer) ? "/admin/logout?idle=1" : "/logout?idle=1" %>';
  var timer = null;
  function reset() {
    if (timer) clearTimeout(timer);
    timer = setTimeout(function () { window.location.href = LOGOUT_URL; }, IDLE_MS);
  }
  ['mousemove', 'mousedown', 'keydown', 'touchstart', 'scroll'].forEach(function (ev) {
    window.addEventListener(ev, reset, { passive: true });
  });
  // Background polls (the live auction room refreshing every 3s) count
  // as activity too — a dealer watching bids is not idle. Only a
  // successful response resets the clock; a 401 means the server already
  // ended the session, so the timer keeps running toward logout.
  var _fetch = window.fetch;
  window.fetch = function () {
    return _fetch.apply(this, arguments).then(function (res) {
      if (res.ok) reset();
      return res;
    });
  };
  reset();
})();
</script>
<% } %>
</body>
</html>
