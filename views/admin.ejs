<%- include('partials/header') %>

<h1>Admin panel</h1>
<p><a class="btn btn-sm" href="/admin/listings/new">Post a demo vehicle</a> <span class="muted small">— list a vehicle under the TradeAutoX demo seller to show how it works.</span></p>

<% if (paymentIssues.length) { %>
<section class="panel">
  <h2>⚠ Payment problems (<%= paymentIssues.length %>)</h2>
  <div class="table-scroll"><table class="table">
    <tr><th>Dealership</th><th>Contact</th><th>Membership</th></tr>
    <% paymentIssues.forEach(d => { %>
      <tr>
        <td><%= d.dealership_name %><br><span class="muted small"><%= d.email %><% if (d.phone) { %> · <%= d.phone %><% } %></span></td>
        <td><%= d.contact_name %></td>
        <td><span class="pill pill-<%= d.membership_status %>"><%= d.membership_status === 'past_due' ? 'past due — card failing' : 'inactive — no longer paying' %></span></td>
      </tr>
    <% }) %>
  </table></div>
  <p class="muted small">Past due = Stripe is retrying their card; the dealer keeps full board access meanwhile and is only locked out if the subscription ends. Inactive = the subscription ended and the dealer is locked out. You also get an email the moment a dealer flips to either one.</p>
</section>
<% } %>

<section class="panel">
  <h2>Pending applications (<%= pending.length %>)</h2>
  <% if (!pending.length) { %>
    <p class="muted">No pending applications.</p>
  <% } else { %>
    <div class="table-scroll"><table class="table">
      <tr><th>Dealership</th><th>Contact</th><th>License #</th><th>License photo</th><th>Driver's license check</th><th>Applied</th><th></th></tr>
      <% pending.forEach(d => { %>
        <tr>
          <td><%= d.dealership_name %><br><span class="muted small"><%= d.email %><% if (d.phone) { %> · <%= d.phone %><% } %></span></td>
          <td><%= d.contact_name %></td>
          <td><%= d.license_number %></td>
          <td><% if (d.license_photo_path) { %><a href="<%= d.license_photo_path %>" target="_blank" rel="noopener">View</a><% } else { %><span class="muted">—</span><% } %></td>
          <td><% if (d.dl_scanned_at) { %>
            <div class="dl-check">
              <div><strong><%= d.dl_name || '—' %></strong><% if (d.dl_state) { %> · <%= d.dl_state %><% } %></div>
              <div>Expires: <%= d.dl_expires || '—' %><% if (d.dl_expired) { %> <span class="dl-expired">EXPIRED</span><% } %></div>
              <% if (d.dl_name_match === 'match') { %>
                <div><span class="dl-ok">✓ Name matches</span> application</div>
              <% } else if (d.dl_name_match === 'mismatch') { %>
                <div><span class="dl-bad">⚠ Name mismatch</span><br>License: <%= d.dl_name || '—' %><br>Application: <%= d.contact_name %></div>
              <% } %>
              <div class="muted">DL # <%= d.dl_number || '—' %> · scanned <%= String(d.dl_scanned_at).slice(0, 10) %></div>
            </div>
          <% } else { %><span class="muted">Not scanned</span><% } %></td>
          <td class="small"><%= d.created_at %></td>
          <td>
            <form method="post" action="/admin/dealers/<%= d.id %>/approve" style="display:inline">
              <button class="btn btn-xs" type="submit">Approve</button>
            </form>
            <form method="post" action="/admin/dealers/<%= d.id %>/reject" style="display:inline">
              <button class="btn btn-xs btn-ghost" type="submit" onclick="return confirm('Reject this application?')">Reject</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table></div>
  <% } %>
</section>

<section class="panel">
  <h2>Password reset requests (<%= resets.length %>)</h2>
  <% if (!resets.length) { %>
    <p class="muted">No open requests.</p>
  <% } else { %>
    <div class="table-scroll"><table class="table">
      <tr><th>Dealership</th><th>Contact</th><th>Requested</th><th></th></tr>
      <% resets.forEach(r => { %>
        <tr>
          <td><%= r.dealership_name %><br><span class="muted small"><%= r.email %></span></td>
          <td><%= r.contact_name %></td>
          <td class="small"><%= r.created_at %></td>
          <td>
            <form method="post" action="/admin/resets/<%= r.id %>/issue" style="display:inline">
              <button class="btn btn-xs" type="submit">Issue temp password</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table></div>
    <p class="muted small">The temporary password shows once on the next screen — pass it to the dealer yourself (call or text). They'll be asked to set a new one on login.</p>
  <% } %>
</section>

<section class="panel">
  <h2>All dealers (<%= members.length %>)</h2>
  <div class="table-scroll"><table class="table">
    <tr><th>Dealership</th><th>Status</th><th>Membership</th><th>Stripe customer</th><th></th></tr>
    <% members.forEach(d => { %>
      <tr>
        <td><%= d.dealership_name %><br><span class="muted small"><%= d.email %></span></td>
        <td><span class="pill pill-<%= d.status %>"><%= d.status %></span></td>
        <td><span class="pill pill-<%= d.membership_status %>"><%= d.membership_status %></span></td>
        <td class="muted small"><%= d.stripe_customer_id || '—' %></td>
        <td>
          <% if (d.email !== demoEmail) { %>
            <% if (d.status === 'approved') { %>
              <form method="post" action="/admin/dealers/<%= d.id %>/suspend" style="display:inline">
                <button class="btn btn-xs btn-ghost" type="submit" onclick="return confirm('Suspend this dealer? They will be locked out and their listings hidden until you reactivate them, and their subscription billing will be paused (no charges while suspended).')">Suspend</button>
              </form>
            <% } %>
            <% if (d.status === 'suspended') { %>
              <form method="post" action="/admin/dealers/<%= d.id %>/reactivate" style="display:inline">
                <button class="btn btn-xs" type="submit">Reactivate</button>
              </form>
            <% } %>
            <form method="post" action="/admin/dealers/<%= d.id %>/remove" style="display:inline">
              <button class="btn btn-xs btn-ghost" type="submit" onclick="return confirm('Remove this dealer permanently? Their listings, auctions, bids and photos will be deleted, and any live subscription will be canceled. This cannot be undone.')">Remove</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </table></div>
  <p class="muted small">Refunds: issue them in the <a href="https://dashboard.stripe.com/payments" target="_blank" rel="noopener">Stripe Dashboard → Payments</a>. Find the payment, click Refund. No code needed — this is handled natively by Stripe.</p>
</section>

<%- include('partials/footer') %>
