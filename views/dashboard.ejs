<%- include('partials/header') %>

<h1>Dashboard</h1>
<p class="muted"><%= dealer.dealership_name %> — <%= dealer.contact_name %> (<%= dealer.email %>)</p>
<% if (typeof employeeUser !== 'undefined' && employeeUser) { %><p class="muted">Signed in as <strong><%= employeeUser.name %></strong> (employee — <%= typeof employeeAccessLabel !== 'undefined' && employeeAccessLabel ? employeeAccessLabel : 'Sell + buy' %>) — billing and settings are managed by the dealership owner.</p><% } %>
<% if (dealer.member_number) { %><p><strong>Your ID: <%= dealer.member_number %></strong> <span class="muted small">— other dealers can find your inventory by this ID</span></p><% } %>
<% if (typeof isOwner !== 'undefined' && isOwner && (dealer.legal_name || dealer.ein || dealer.company_type)) { %>
<section class="panel">
  <h2>Business verification</h2>
  <p class="muted small">The paperwork behind your member ID — verified at approval. Read-only; contact TradeAutoX if anything needs updating.</p>
  <p>Legal name: <strong><%= dealer.legal_name || '—' %></strong><% if (dealer.dba) { %><br>DBA: <%= dealer.dba %><% } %><br>Company type: <%= dealer.company_type || '—' %> · EIN: <%= dealer.ein || '—' %><% if (dealer.auction_access_id) { %><br>AuctionACCESS ID: <%= dealer.auction_access_id %><% } %></p>
</section>
<% } %>

<% if (typeof notice !== 'undefined' && notice) { %><p class="alert ok"><%= notice %></p><% } %>
<% if (typeof error !== 'undefined' && error) { %><p class="alert error"><%= error %></p><% } %>
<% if (typeof mustChangePassword !== 'undefined' && mustChangePassword) { %>
  <p class="alert warn"><strong>You're using a temporary password.</strong> <a href="/change-password">Set a new password</a> to secure your account.</p>
<% } %>
<p class="muted small"><a href="/change-password">Change password</a></p>

<% if (typeof notifications !== 'undefined' && notifications.length) { %>
<section class="panel">
  <h2>New alerts</h2>
  <% notifications.forEach(n => { %>
    <p><% if (n.kind === 'auction_alert' || n.kind === 'auction_won' || n.kind === 'auction_outbid') { %><span class="live-badge">LIVE</span> <% } %><%= n.message %><% if (n.ref_id) { %> <a href="/auctions/<%= n.ref_id %>">Open</a><% } %></p>
  <% }) %>
</section>
<% } %>

<% if (typeof liveNearMe !== 'undefined' && liveNearMe.length) { %>
<section class="panel">
  <h2>Live auctions near you</h2>
  <% liveNearMe.forEach(a => { %>
    <p><span class="live-badge">LIVE</span> <a href="/auctions/<%= a.id %>"><%= a.year %> <%= a.make %> <%= a.model %><% if (a.trim) { %> <%= a.trim %><% } %></a> — <%= a.distance %> mi away · <%= a.dealership_name %> · ends <%= new Date(a.ends_at).toLocaleTimeString('en-US', { timeZone: 'America/New_York', hour: 'numeric', minute: '2-digit' }) %> ET</p>
  <% }) %>
</section>
<% } %>

<section class="panel">
  <h2>Dealership address</h2>
  <p class="muted small">Your ZIP powers radius search on the board and decides which live auctions alert you. Your street address appears on deal sheets so buyers know where to pick up.</p>
  <% if (typeof isOwner !== 'undefined' && isOwner) { %>
  <form class="form" method="post" action="/dashboard/zip">
    <div class="row">
      <label>Street address
        <input name="address" value="<%= dealer.address || '' %>" autocomplete="street-address">
      </label>
    </div>
    <div class="row">
      <label>City
        <input name="city" value="<%= dealer.city || '' %>" autocomplete="address-level2">
      </label>
      <label>State
        <input name="state" maxlength="2" value="<%= dealer.state || '' %>" autocomplete="address-level1" placeholder="GA">
      </label>
      <label>ZIP code
        <input name="zip" inputmode="numeric" maxlength="5" value="<%= dealer.zip || '' %>" placeholder="e.g. 30339">
      </label>
    </div>
    <button class="btn btn-sm" type="submit">Save address</button>
  </form>
  <% } else { %>
  <p class="muted">Address is managed by the dealership owner.</p>
  <% } %>
</section>

<section class="panel">
  <h2>Live auctions <% if (typeof canSell === 'undefined' || canSell) { %><a class="btn btn-sm" href="/auctions/new">Start one</a> <% } %><a class="btn btn-sm btn-ghost" href="/auctions">All live</a></h2>
  <% if (typeof myAuctions === 'undefined' || !myAuctions.length) { %>
    <p class="muted">No auctions yet. Working a trade-in? Fire it live and let nearby dealers bid in real time.</p>
  <% } else { %>
    <div class="table-scroll"><table class="table">
      <tr><th>Vehicle</th><th>Status</th><th>Ends / ended</th><th></th></tr>
      <% myAuctions.forEach(a => { %>
        <tr>
          <td><a href="/auctions/<%= a.id %>"><%= a.year %> <%= a.make %> <%= a.model %></a></td>
          <td><% if (a.status === 'live') { %><span class="live-badge">LIVE</span><% } else { %><%= a.status %><% } %></td>
          <td><%= new Date(a.ends_at).toLocaleString('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %> ET</td>
          <td><a href="/auctions/<%= a.id %>">Open</a></td>
        </tr>
      <% }) %>
    </table></div>
  <% } %>
</section>

<section class="panel">
  <h2>Membership</h2>
  <% if (dealer.status === 'pending') { %>
    <p class="alert warn"><strong>Application under review.</strong> We verify every wholesale license before activation. You'll be able to activate your membership once approved.</p>
  <% } else if (dealer.status === 'rejected') { %>
    <p class="alert error">This application was not approved. Please contact support.</p>
  <% } else if (dealer.membership_status === 'active') { %>
    <p class="alert ok"><strong>Active member.</strong> Your $599/month membership is current.</p>
    <% if (typeof isOwner !== 'undefined' && isOwner) { %>
    <form method="post" action="/billing/portal" style="display:inline">
      <button class="btn btn-sm" type="submit">Manage billing</button>
    </form>
    <p class="muted small">Update your card, view invoices, or cancel from the secure billing portal.</p>
    <% } else { %>
    <p class="muted small">Billing is managed by the dealership owner.</p>
    <% } %>
  <% } else if (dealer.membership_status === 'past_due') { %>
    <p class="alert error"><strong>Payment past due.</strong> Your last $599 charge failed and Stripe is retrying your card. You can keep trading meanwhile, but update your payment method soon — if the retries run out, your subscription ends and your access is paused.</p>
    <% if (typeof isOwner !== 'undefined' && isOwner) { %>
    <form method="post" action="/billing/portal" style="display:inline">
      <button class="btn btn-sm" type="submit">Update payment method</button>
    </form>
    <% } else { %>
    <p class="muted small">Billing is managed by the dealership owner.</p>
    <% } %>
  <% } else { %>
    <p><strong>You're approved!</strong> Activate your membership to start buying and selling — first 30 days free, then $599/month.</p>
    <% if (typeof isOwner !== 'undefined' && isOwner) { %>
    <% if (stripeConfigured) { %>
      <form method="post" action="/billing/checkout">
        <button class="btn" type="submit">Start free 30-day trial</button>
      </form>
    <% } else { %>
      <p class="alert warn">Online billing isn't configured on this server yet. Contact the site administrator to activate.</p>
    <% } %>
    <% } else { %>
    <p class="muted small">Membership activation is handled by the dealership owner.</p>
    <% } %>
  <% } %>
</section>

<section class="panel">
  <h2>Trade Partners <a class="btn btn-sm btn-ghost" href="/listings?search_type=partners">View their inventory</a></h2>
  <p class="muted small">Follow the dealers you trade with regularly. Add them by their member ID, then filter the board to just their inventory.</p>
  <form class="form" method="post" action="/dashboard/trade-partners">
    <div class="row">
      <label>Dealer ID
        <input name="member_number" inputmode="numeric" placeholder="e.g. 1001">
      </label>
    </div>
    <button class="btn btn-sm" type="submit">Add trade partner</button>
  </form>
  <% if (typeof tradePartners === 'undefined' || !tradePartners.length) { %>
    <p class="muted">No trade partners yet.</p>
  <% } else { %>
    <div class="table-scroll"><table class="table">
      <tr><th>ID</th><th>Dealership</th><th>Location</th><th></th></tr>
      <% tradePartners.forEach(p => { %>
        <tr>
          <td><%= p.member_number %></td>
          <td><%= p.dealership_name %></td>
          <td><%= [p.city, p.state].filter(Boolean).join(', ') || '—' %></td>
          <td>
            <a class="btn btn-xs btn-ghost" href="/listings?search_type=id&amp;member_number=<%= p.member_number %>">View inventory</a>
            <form method="post" action="/dashboard/trade-partners/<%= p.id %>/remove" style="display:inline">
              <button class="btn btn-xs btn-ghost" type="submit">Remove</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table></div>
  <% } %>
</section>

<% if (typeof isOwner !== 'undefined' && isOwner) { %>
<section class="panel">
  <h2>Employee logins</h2>
  <p class="muted small">Let people at your dealership sign in with their own email. Give each person the access they need — sell only, buy only, or both. Nobody but you touches billing, your address, or other employees.</p>
  <form class="form" method="post" action="/dashboard/employee-logins">
    <label>Employee logins
      <select name="enabled">
        <option value="0"<%= dealer.employee_logins_enabled ? '' : ' selected' %>>Off — owner only</option>
        <option value="1"<%= dealer.employee_logins_enabled ? ' selected' : '' %>>On — employees can sign in</option>
      </select>
    </label>
    <button class="btn btn-sm" type="submit">Save</button>
  </form>
  <% if (dealer.employee_logins_enabled) { %>
    <form class="form" method="post" action="/dashboard/employees">
      <div class="row">
        <label>Name<input name="name" placeholder="e.g. Sam Carter" required></label>
        <label>Email<input name="email" type="email" placeholder="sam@yourdealership.com" required></label>
        <label>Temporary password<input name="temp_password" type="password" placeholder="At least 8 characters" required></label>
        <label>Access
          <select name="access_level">
            <option value="both" selected>Both — sell + buy</option>
            <option value="sell">Sell only</option>
            <option value="buy">Buy only</option>
          </select>
        </label>
      </div>
      <button class="btn btn-sm" type="submit">Add employee</button>
    </form>
    <p class="muted small">They'll set their own password the first time they sign in. Share the temporary password with them directly.</p>
    <% if (typeof employees !== 'undefined' && employees.length) { %>
      <div class="table-scroll"><table class="table">
        <tr><th>Name</th><th>Email</th><th>Access</th><th>Status</th><th></th></tr>
        <% employees.forEach(u => { %>
          <tr>
            <td><%= u.name %></td>
            <td><%= u.email %></td>
            <td>
              <form method="post" action="/dashboard/employees/<%= u.id %>/access" style="display:inline">
                <select name="access_level" onchange="this.form.submit()" title="Change what <%= u.name %> can do">
                  <option value="both"<%= (u.access_level || 'both') === 'both' ? ' selected' : '' %>>Both</option>
                  <option value="sell"<%= u.access_level === 'sell' ? ' selected' : '' %>>Sell only</option>
                  <option value="buy"<%= u.access_level === 'buy' ? ' selected' : '' %>>Buy only</option>
                </select>
              </form>
            </td>
            <td><%= u.active ? 'Active' : 'Off' %><% if (u.must_change_password) { %> · temp password<% } %></td>
            <td>
              <form method="post" action="/dashboard/employees/<%= u.id %>/toggle" style="display:inline">
                <button class="btn btn-xs btn-ghost" type="submit"><%= u.active ? 'Switch off' : 'Switch on' %></button>
              </form>
            </td>
          </tr>
        <% }) %>
      </table></div>
    <% } else { %>
      <p class="muted">No employees yet.</p>
    <% } %>
  <% } %>
</section>
<% } %>

<section class="panel">
  <h2>My listings <% if (typeof canSell === 'undefined' || canSell) { %><a class="btn btn-sm" href="/listings/new">+ New listing</a> <a class="btn btn-sm btn-ghost" href="/listings/bulk">Bulk Import</a><% } %></h2>
  <% if (!listings.length) { %>
    <p class="muted">No listings yet.</p>
  <% } else { %>
    <div class="table-scroll"><table class="table">
      <tr><th>Vehicle</th><th>Price</th><th>Status</th><th>Days on site</th><th></th></tr>
      <% listings.forEach(l => { %>
        <tr>
          <td><% if (l.status === 'draft') { %><a href="/listings/<%= l.id %>/add-photos"><%= l.year %> <%= l.make %> <%= l.model %></a><% } else { %><a href="/listings/<%= l.id %>"><%= l.year %> <%= l.make %> <%= l.model %></a><% } %></td>
          <td><%= fmtMoney(l.price) %></td>
          <td><% if (l.status === 'draft') { %>Draft — <%= l.photoCounts.total %>/15 photos (<%= l.photoCounts.exterior %> exterior, <%= l.photoCounts.interior %> interior)<% } else { %><%= l.status %><% } %><% if (l.pendingSale) { %> · Sale pending (<%= l.pendingSale %><% if (l.pendingBuyer) { %> — <%= l.pendingBuyer %><% } %><% if (l.pendingDays != null) { %> — <%= l.pendingDays === 0 ? 'today' : l.pendingDays + (l.pendingDays === 1 ? ' day' : ' days') %><% } %>)<% } %></td>
          <td><%= l.daysOnSite || '—' %></td>
          <td>
            <% if (typeof canSell === 'undefined' || canSell) { %>
            <% if (l.status === 'draft') { %>
              <a class="btn btn-xs" href="/listings/<%= l.id %>/add-photos">Add photos</a>
            <% } else if (l.status === 'active') { %>
              <form method="post" action="/listings/<%= l.id %>/status" style="display:inline">
                <input type="hidden" name="status" value="sold">
                <button class="btn btn-xs" type="submit">Mark sold</button>
              </form>
              <form method="post" action="/listings/<%= l.id %>/status" style="display:inline">
                <input type="hidden" name="status" value="removed">
                <button class="btn btn-xs btn-ghost" type="submit">Remove</button>
              </form>
            <% } %>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </table></div>
  <% } %>
</section>

<%- include('partials/footer') %>
