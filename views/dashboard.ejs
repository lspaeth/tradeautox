<%- include('partials/header') %>

<h1>Dashboard</h1>
<p class="muted"><%= dealer.dealership_name %> — <%= dealer.contact_name %> (<%= dealer.email %>)</p>

<% if (typeof notice !== 'undefined' && notice) { %><p class="alert ok"><%= notice %></p><% } %>
<% if (dealer.must_change_password) { %>
  <p class="alert warn"><strong>You're using a temporary password.</strong> <a href="/change-password">Set a new password</a> to secure your account.</p>
<% } %>
<p class="muted small"><a href="/change-password">Change password</a></p>

<% if (typeof notifications !== 'undefined' && notifications.length) { %>
<section class="panel">
  <h2>New alerts</h2>
  <% notifications.forEach(n => { %>
    <p><% if (n.kind === 'auction_alert' || n.kind === 'auction_won' || n.kind === 'auction_outbid') { %><span class="live-badge">LIVE</span> <% } %><%= n.message %><% if (n.ref_id) { %> <a href="/auctions/<%= n.ref_id %>">Open</a><% } %></p>
  <% }) %>
</section>
<% } %>

<% if (typeof liveNearMe !== 'undefined' && liveNearMe.length) { %>
<section class="panel">
  <h2>Live auctions near you</h2>
  <% liveNearMe.forEach(a => { %>
    <p><span class="live-badge">LIVE</span> <a href="/auctions/<%= a.id %>"><%= a.year %> <%= a.make %> <%= a.model %><% if (a.trim) { %> <%= a.trim %><% } %></a> — <%= a.distance %> mi away · <%= a.dealership_name %> · ends <%= new Date(a.ends_at).toLocaleTimeString('en-US', { timeZone: 'America/New_York', hour: 'numeric', minute: '2-digit' }) %> ET</p>
  <% }) %>
</section>
<% } %>

<section class="panel">
  <h2>Dealership ZIP</h2>
  <p class="muted small">Your ZIP powers radius search on the board and decides which live auctions alert you.</p>
  <form class="form" method="post" action="/dashboard/zip">
    <div class="row">
      <label>ZIP code
        <input name="zip" inputmode="numeric" maxlength="5" value="<%= dealer.zip || '' %>" placeholder="e.g. 30339">
      </label>
    </div>
    <button class="btn btn-sm" type="submit"><%= dealer.zip ? 'Update ZIP' : 'Save ZIP' %></button>
  </form>
</section>

<section class="panel">
  <h2>Live auctions <a class="btn btn-sm" href="/auctions/new">Start one</a> <a class="btn btn-sm btn-ghost" href="/auctions">All live</a></h2>
  <% if (typeof myAuctions === 'undefined' || !myAuctions.length) { %>
    <p class="muted">No auctions yet. Working a trade-in? Fire it live and let nearby dealers bid in real time.</p>
  <% } else { %>
    <div class="table-scroll"><table class="table">
      <tr><th>Vehicle</th><th>Status</th><th>Ends / ended</th><th></th></tr>
      <% myAuctions.forEach(a => { %>
        <tr>
          <td><a href="/auctions/<%= a.id %>"><%= a.year %> <%= a.make %> <%= a.model %></a></td>
          <td><% if (a.status === 'live') { %><span class="live-badge">LIVE</span><% } else { %><%= a.status %><% } %></td>
          <td><%= new Date(a.ends_at).toLocaleString('en-US', { timeZone: 'America/New_York', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %> ET</td>
          <td><a href="/auctions/<%= a.id %>">Open</a></td>
        </tr>
      <% }) %>
    </table></div>
  <% } %>
</section>

<section class="panel">
  <h2>Membership</h2>
  <% if (dealer.status === 'pending') { %>
    <p class="alert warn"><strong>Application under review.</strong> We verify every wholesale license before activation. You'll be able to activate your membership once approved.</p>
  <% } else if (dealer.status === 'rejected') { %>
    <p class="alert error">This application was not approved. Please contact support.</p>
  <% } else if (dealer.membership_status === 'active') { %>
    <p class="alert ok"><strong>Active member.</strong> Your $599/month membership is current.</p>
    <form method="post" action="/billing/portal" style="display:inline">
      <button class="btn btn-sm" type="submit">Manage billing</button>
    </form>
    <p class="muted small">Update your card, view invoices, or cancel from the secure billing portal.</p>
  <% } else if (dealer.membership_status === 'past_due') { %>
    <p class="alert error"><strong>Payment past due.</strong> Your last $599 charge failed and Stripe is retrying your card. You can keep trading meanwhile, but update your payment method soon — if the retries run out, your subscription ends and your access is paused.</p>
    <form method="post" action="/billing/portal" style="display:inline">
      <button class="btn btn-sm" type="submit">Update payment method</button>
    </form>
  <% } else { %>
    <p><strong>You're approved!</strong> Activate your membership to start buying and selling — first 30 days free, then $599/month.</p>
    <% if (stripeConfigured) { %>
      <form method="post" action="/billing/checkout">
        <button class="btn" type="submit">Start free 30-day trial</button>
      </form>
    <% } else { %>
      <p class="alert warn">Online billing isn't configured on this server yet. Contact the site administrator to activate.</p>
    <% } %>
  <% } %>
</section>

<section class="panel">
  <h2>My listings <a class="btn btn-sm" href="/listings/new">+ New listing</a> <a class="btn btn-sm btn-ghost" href="/listings/bulk">Bulk Import</a></h2>
  <% if (!listings.length) { %>
    <p class="muted">No listings yet.</p>
  <% } else { %>
    <div class="table-scroll"><table class="table">
      <tr><th>Vehicle</th><th>Price</th><th>Status</th><th></th></tr>
      <% listings.forEach(l => { %>
        <tr>
          <td><a href="/listings/<%= l.id %>"><%= l.year %> <%= l.make %> <%= l.model %></a></td>
          <td><%= fmtMoney(l.price) %></td>
          <td><%= l.status %></td>
          <td>
            <% if (l.status === 'active') { %>
              <form method="post" action="/listings/<%= l.id %>/status" style="display:inline">
                <input type="hidden" name="status" value="sold">
                <button class="btn btn-xs" type="submit">Mark sold</button>
              </form>
              <form method="post" action="/listings/<%= l.id %>/status" style="display:inline">
                <input type="hidden" name="status" value="removed">
                <button class="btn btn-xs btn-ghost" type="submit">Remove</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </table></div>
  <% } %>
</section>

<%- include('partials/footer') %>
