<%- include('partials/header') %>

<h1>Change password</h1>

<% if (error) { %><p class="alert error"><%= error %></p><% } %>
<% if (notice) { %><p class="alert ok"><%= notice %></p><% } %>

<form class="form" method="post" action="/change-password">
  <label>Current password
    <span class="pw-wrap">
      <input type="password" name="current_password" required>
      <button type="button" class="pw-toggle" aria-label="Show password">👁</button>
    </span>
  </label>
  <label>New password
    <span class="pw-wrap">
      <input type="password" name="new_password" minlength="8" required>
      <button type="button" class="pw-toggle" aria-label="Show password">👁</button>
    </span>
  </label>
  <button class="btn" type="submit">Update password</button>
</form>
<p class="muted"><a href="/dashboard">Back to dashboard</a></p>

<%- include('partials/password-toggle') %>
<%- include('partials/footer') %>
