<%- include('partials/header') %>

<p><a href="/listings">&larr; Back to board</a></p>

<div class="alert warn"><strong>TradeAutoX is not a party to this transaction.</strong> All sales are strictly between buyer and seller, as-is.</div>

<h1><%= listing.year %> <%= listing.make %> <%= listing.model %></h1>
<% if (listing.verification_report) { %>
  <p><span class="verified-badge">✓ Verified</span> <span class="muted small">Seller provided a diagnostic verification report — <a href="<%= listing.verification_report %>" target="_blank" rel="noopener">view report</a></span></p>
<% } %>
<p class="price-lg"><%= fmtMoney(listing.price) %></p>

<% if (photos.length) { %>
  <div class="photo-grid">
    <% photos.forEach(p => { %>
      <a href="<%= p.path %>" target="_blank" rel="noopener"><img src="<%= p.path %>" alt="Vehicle photo"></a>
    <% }) %>
  </div>
<% } %>

<dl class="specs">
  <% if (listing.vin) { %><dt>VIN</dt><dd><%= listing.vin %></dd><% } %>
  <% if (listing.trim) { %><dt>Trim</dt><dd><%= listing.trim %></dd><% } %>
  <% if (listing.body_style) { %><dt>Body</dt><dd><%= listing.body_style %></dd><% } %>
  <% if (listing.drivetrain) { %><dt>Drivetrain</dt><dd><%= listing.drivetrain %></dd><% } %>
  <% if (listing.engine) { %><dt>Engine</dt><dd><%= listing.engine %></dd><% } %>
  <% if (listing.transmission) { %><dt>Transmission</dt><dd><%= listing.transmission %></dd><% } %>
  <% if (listing.fuel) { %><dt>Fuel</dt><dd><%= listing.fuel %></dd><% } %>
  <% if (listing.doors) { %><dt>Doors</dt><dd><%= listing.doors %></dd><% } %>
  <% if (listing.color) { %><dt>Color</dt><dd><%= listing.color %></dd><% } %>
  <% if (listing.title_status) { %><dt>Title</dt><dd><%= listing.title_status %></dd><% } %>
  <% if (listing.mileage) { %><dt>Mileage</dt><dd><%= Number(listing.mileage).toLocaleString() %> mi</dd><% } %>
  <dt>Seller</dt><dd><%= listing.dealership_name %></dd>
  <dt>Contact</dt><dd><%= listing.contact_name %><% if (listing.phone) { %> — <%= listing.phone %><% } %></dd>
</dl>

<% if (listing.description) { %>
  <h2>Description</h2>
  <p class="pre"><%= listing.description %></p>
<% } %>

<% if (canManage) { %>
  <section class="panel">
    <h2>Manage this listing</h2>
    <div class="cta-row">
      <form method="post" action="<%= isAdmin ? '/admin/listings/' + listing.id + '/status' : '/listings/' + listing.id + '/status' %>" style="display:inline">
        <input type="hidden" name="status" value="sold">
        <button class="btn btn-sm" type="submit">Mark sold</button>
      </form>
      <form method="post" action="<%= isAdmin ? '/admin/listings/' + listing.id + '/status' : '/listings/' + listing.id + '/status' %>" style="display:inline">
        <input type="hidden" name="status" value="removed">
        <button class="btn btn-sm btn-ghost" type="submit" onclick="return confirm('Remove this listing from the board?')">Delete listing</button>
      </form>
    </div>
  </section>
<% } %>

<p class="muted small"><% if (listing.daysOnSite) { %><%= listing.daysOnSite %><% } else { %>Listed <%= listing.created_at %><% } %>. Dealers transact directly — TradeAutoX charges no per-vehicle fees.</p>

<%- include('partials/footer') %>
