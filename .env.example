# Server
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
BASE_URL=http://localhost:3000

# Admin panel login (pick strong values)
ADMIN_EMAIL=admin@tradeautox.com
ADMIN_PASSWORD=change-me

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# SQLite file location (defaults to ./tradeautox.db)
DB_PATH=./tradeautox.db
